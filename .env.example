# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-database-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local dev server port
PORT=5173

# Public site URL used for canonical, Open Graph, robots.txt, and sitemap.xml.
# Leave unset locally and on Vercel: Vercel automatically uses the production URL.
# Set this only when you move to a custom domain.
# SITE_URL=https://your-custom-domain.com
